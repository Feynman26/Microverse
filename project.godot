; Engine configuration file.
; Edit through the Godot editor when possible.
config_version=5

[application]
config/name="Microverse"
run/main_scene="res://src/ui/main.tscn"

[display]
window/size/viewport_width=920
window/size/viewport_height=640
window/size/window_width_override=920
window/size/window_height_override=640
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.025, 0.03, 0.04, 1)
